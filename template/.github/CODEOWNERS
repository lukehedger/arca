# Copilot code review reads its rules from the pull request branch, so a human owner approves every change to them.
/.github/copilot-instructions.md <owner>
# if: greenfield
/CLAUDE.md <owner>
/.claude/rules/ <owner>

# A merge deploys these files to production as whole-profile replacements.
/packages/config/environments/production/ <owner>
# if: migration
/<app-dir>/CLAUDE.md <owner>
/<app-dir>/.claude/rules/ <owner>

# A merge deploys these files to production as whole-profile replacements.
/<app-dir>/packages/config/environments/production/ <owner>
# end
