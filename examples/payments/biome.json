{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": ["**", "!.claude", "!tools/wren/claude/types"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUndeclaredDependencies": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noInferrableTypes": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "useAsConstAssertion": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useConst": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noVar": "error",
        "noImportCycles": "error"
      }
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "overrides": [
    {
      "includes": ["tools/wren/claude/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["api/**", "!api/**/tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@payments/*",
                      "!@payments/schema",
                      "!@payments/gate",
                      "!@payments/http",
                      "!@payments/telemetry",
                      "@aws-sdk/*"
                    ],
                    "message": "A handler declares its route with createApiHandler, which parses the request, calls the gate and maps the result. Move any other logic down a layer."
                  },
                  {
                    "group": [
                      "../**/api/**",
                      "../**/async/**",
                      "../**/core/**",
                      "../**/infra/**",
                      "../**/packages/**",
                      "../**/tools/**"
                    ],
                    "message": "Import another workspace package by its name so the layer rules apply."
                  },
                  {
                    "group": ["bun", "bun:*", "!bun:test"],
                    "message": "Bun is dev tooling only. Deployed code runs on Node.js."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["async/**", "api/**/tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@payments/*",
                      "!@payments/schema",
                      "!@payments/gate",
                      "!@payments/telemetry",
                      "@aws-sdk/*",
                      "!@payments/errors"
                    ],
                    "message": "A handler parses the request into a command, passes it to the gate and maps the result. Move any other logic down a layer."
                  },
                  {
                    "group": [
                      "../**/api/**",
                      "../**/async/**",
                      "../**/core/**",
                      "../**/infra/**",
                      "../**/packages/**",
                      "../**/tools/**"
                    ],
                    "message": "Import another workspace package by its name so the layer rules apply."
                  },
                  {
                    "group": ["bun", "bun:*", "!bun:test"],
                    "message": "Bun is dev tooling only. Deployed code runs on Node.js."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/http/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@payments/*",
                      "!@payments/errors",
                      "!@payments/telemetry"
                    ],
                    "message": "The HTTP package turns a route declaration into a handler. It maps errors and knows nothing of the gate, the store or the core."
                  },
                  {
                    "group": [
                      "../**/api/**",
                      "../**/async/**",
                      "../**/core/**",
                      "../**/infra/**",
                      "../**/packages/**",
                      "../**/tools/**"
                    ],
                    "message": "Import another workspace package by its name so the layer rules apply."
                  },
                  {
                    "group": ["bun", "bun:*", "!bun:test"],
                    "message": "Bun is dev tooling only. Deployed code runs on Node.js."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/gate/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@payments/*",
                      "!@payments/core",
                      "!@payments/store",
                      "!@payments/telemetry",
                      "!@payments/errors"
                    ],
                    "message": "The gate loads state from the store, asks the core for a decision and persists it. It calls only the core and the store."
                  },
                  {
                    "group": [
                      "../**/api/**",
                      "../**/async/**",
                      "../**/core/**",
                      "../**/infra/**",
                      "../**/packages/**",
                      "../**/tools/**"
                    ],
                    "message": "Import another workspace package by its name so the layer rules apply."
                  },
                  {
                    "group": ["bun", "bun:*", "!bun:test"],
                    "message": "Bun is dev tooling only. Deployed code runs on Node.js."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/store/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@payments/*", "!@payments/telemetry"],
                    "message": "The store persists state. It knows nothing of the layers above it, including the core."
                  },
                  {
                    "group": [
                      "../**/api/**",
                      "../**/async/**",
                      "../**/core/**",
                      "../**/infra/**",
                      "../**/packages/**",
                      "../**/tools/**"
                    ],
                    "message": "Import another workspace package by its name so the layer rules apply."
                  },
                  {
                    "group": ["bun", "bun:*", "!bun:test"],
                    "message": "Bun is dev tooling only. Deployed code runs on Node.js."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/telemetry/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@payments/*", "!@payments/errors"],
                    "message": "Telemetry depends only on the errors package, which classifies the failures it records."
                  },
                  {
                    "group": [
                      "../**/api/**",
                      "../**/async/**",
                      "../**/core/**",
                      "../**/infra/**",
                      "../**/packages/**",
                      "../**/tools/**"
                    ],
                    "message": "Import another workspace package by its name so the layer rules apply."
                  },
                  {
                    "group": ["bun", "bun:*", "!bun:test"],
                    "message": "Bun is dev tooling only. Deployed code runs on Node.js."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/schema/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@payments/*", "!@payments/core"],
                    "message": "The schema parses data at the boundary into the core's types. It imports only the core."
                  },
                  {
                    "group": [
                      "../**/api/**",
                      "../**/async/**",
                      "../**/core/**",
                      "../**/infra/**",
                      "../**/packages/**",
                      "../**/tools/**"
                    ],
                    "message": "Import another workspace package by its name so the layer rules apply."
                  },
                  {
                    "group": ["bun", "bun:*", "!bun:test"],
                    "message": "Bun is dev tooling only. Deployed code runs on Node.js."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/errors/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@payments/*"],
                    "message": "This package is a leaf. It depends on no other workspace package."
                  },
                  {
                    "group": [
                      "../**/api/**",
                      "../**/async/**",
                      "../**/core/**",
                      "../**/infra/**",
                      "../**/packages/**",
                      "../**/tools/**"
                    ],
                    "message": "Import another workspace package by its name so the layer rules apply."
                  },
                  {
                    "group": ["bun", "bun:*", "!bun:test"],
                    "message": "Bun is dev tooling only. Deployed code runs on Node.js."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "api/**",
        "async/**",
        "packages/**",
        "!packages/constructs/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "Bun is dev tooling only. Deployed code runs on Node.js."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["core/**"],
      "plugins": ["./tools/fitness/rules/deterministic-core.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@payments/*",
                      "@aws-sdk/*",
                      "@aws-lambda-powertools/*",
                      "@aws/*"
                    ],
                    "message": "The core is pure. It imports no other workspace package and no AWS library. Return a decision and let the gate do the I/O."
                  },
                  {
                    "group": [
                      "../**/api/**",
                      "../**/async/**",
                      "../**/core/**",
                      "../**/infra/**",
                      "../**/packages/**",
                      "../**/tools/**"
                    ],
                    "message": "Import another workspace package by its name so the layer rules apply."
                  },
                  {
                    "group": ["bun", "bun:*", "!bun:test"],
                    "message": "Bun is dev tooling only. Deployed code runs on Node.js."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "Bun is dev tooling only. Deployed code runs on Node.js.",
                  "Date": "The core is deterministic. Pass the time in with the command.",
                  "FinalizationRegistry": "The core is deterministic. Garbage collection timing must not reach a decision.",
                  "WeakRef": "The core is deterministic. Garbage collection timing must not reach a decision.",
                  "crypto": "The core is deterministic. Pass generated identifiers in with the command.",
                  "fetch": "The core does no I/O. Return a decision and let the gate do the I/O.",
                  "globalThis": "The core reads no globals. Pass what it needs in with the command.",
                  "performance": "The core is deterministic. Pass the time in with the command.",
                  "process": "The core reads no environment. Pass config in.",
                  "queueMicrotask": "The core does no scheduling.",
                  "setImmediate": "The core does no scheduling.",
                  "setInterval": "The core does no scheduling.",
                  "setTimeout": "The core does no scheduling."
                }
              }
            }
          },
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["**/tests/**", "tools/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
